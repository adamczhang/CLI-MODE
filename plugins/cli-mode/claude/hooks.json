{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 300,
           "statusMessage": "CLI-MODE"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|ScheduleWakeup|CronCreate|Monitor",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15,
           "if": "Bash(python *)"}
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15,
           "if": "PowerShell(python *)"}
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15,
           "if": "Edit(**/Agent_Working_Folder/BRIEF.md)"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude.py"], "timeout": 15}
        ]
      }
    ]
  }
}
